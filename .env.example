# ── LLM ──────────────────────────────────────────────────────────────────────
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# ── Vector Store ──────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ── Langfuse Tracing ─────────────────────────────────────────────────────────
# Sign up free at https://cloud.langfuse.com, then copy your keys from Settings > API Keys
# Leave empty to disable tracing (app still works, just no trace dashboard)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── App ───────────────────────────────────────────────────────────────────────
API_URL=http://localhost:8000
